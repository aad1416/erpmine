  "updated_at" timestamptz [not null]
  "jobrecord_id" uuid [not null]
  "unit_id" uuid [not null]
  "issue_line_item_id" uuid [not null]
  "inventory_item_id" uuid [not null]
  "receive_id" uuid
  "receive_line_item_id" uuid
  "purchase_order_id" uuid
  "quantity" numeric(12,2) [not null]
}

Table "goods_issue_line_item_returns" {
  "id" uuid [pk, not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "store_id" uuid [not null]
  "goods_issue_id" uuid [not null]
  "goods_issue_line_item_id" uuid [not null]
  "quantity" numeric(12,2) [not null, default: 0]
  "creator_id" uuid [not null]

  Indexes {
    created_at [type: btree, name: "goods_issue_line_item_returns_created_at_index"]
    goods_issue_id [type: btree, name: "goods_issue_line_item_returns_goods_issue_id_index"]
  }
}

Table "fifo_reports" {
  "id" uuid [pk, not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "date" int8 [not null]
  "type" text [not null, check: `type = ANY (ARRAY['ADD'::text, 'REDUCE'::text])`]
  "item_store_id" uuid [not null]
  "receive_id" uuid
  "goods_issue_id" uuid
  "receive_or_issue_or_cycle_count_number" text
  "purchase_order_id" uuid
  "purchase_order_number" text
  "cycle_count_id" uuid
  "quantity" numeric(10,2) [not null]
  "value" numeric(10,2) [not null]
  "note" text
}

Table "field_service_tasks" {
  "id" uuid [pk, not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "store_id" uuid [not null]
  "start" int8
  "end" int8
  "due_date" int8
  "type" field_service_task_type_enum [not null]
  "requested_by_id" uuid [not null]
  "requested_by_name" text [not null]
  "assigned_to_id" uuid
  "assigned_to_name" text
  "sales_order_id" uuid
  "sales_order_number" text
  "unit_id" uuid
  "unit_serial_number" text
  "ticket_id" uuid
  "ticket_number" text
  "description" text [not null]
  "number" text [not null]
  "title" text [not null]
  "status" field_service_task_status_enum [not null]
  "creator_id" uuid [not null]
}

Table "warranties" {
  "id" uuid [pk, not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "number" text [not null]
  "start" int8 [not null]
  "end" int8 [not null]
  "name" text [not null]
  "notes" text
  "terms" text
  "status" warranty_status_enum [not null]
  "unit_id" uuid [not null]
}

Table "mikro_orm_migrations" {
  "id" int4 [pk, not null, increment]
  "name" varchar(255)
  "executed_at" timestamptz [default: `CURRENT_TIMESTAMP`]
}

Table "instruction_change" {
  "id" uuid [pk, not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "set_id" uuid [not null]
  "store_id" uuid [not null]
  "item_store_id" uuid [not null]
  "instruction_id" uuid
  "type" instruction_change_type [not null]
  "instruction_info_title" text [not null]
  "instruction_info_subtitle" text [not null]
  "instruction_info_content" text [not null]
  "instruction_info_step" text [not null]
  "instruction_info_type" production_instruction_type [not null, default: 'INSTRUCTION']
  "instruction_info_args" jsonb [not null]
  "instruction_info_checkboxes" jsonb [not null]
  "creator_id" uuid [not null]
  "is_active" bool [not null, default: true]
}

